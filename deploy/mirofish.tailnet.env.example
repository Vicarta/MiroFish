# Tailnet-only bind ports on the VPS host
MIROFISH_UI_PORT=13000
MIROFISH_API_PORT=15001
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Required LLM settings
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Required Zep memory graph settings
ZEP_API_KEY=REPLACE_ME

# Optional LLM boost settings
# Remove these lines entirely if you do not use a boost provider.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
